@misc{MEC_IFCE_2024,
	author       = {{Ministério da Educação}},
	title        = {MEC assina autorização de projetos para 6 novos campi do IFCE},
	year         = {2024},
	howpublished = {Portal do Governo Federal},
	url          = {https://www.gov.br/mec/pt-br/assuntos/noticias/2024/outubro/mec-assina-autorizacao-de-projetos-para-6-novos-campi-do-ifce},
	note         = {Acesso em: 07 nov. 2025},
	abstract     = {Por meio do Novo Plano de Aceleração do Crescimento (Novo PAC), as construções receberão um investimento de R\$ 150 milhões do governo federal. Atualmente, o IFCE conta com 34 unidades, sendo 33 campi e um polo de inovação. Os novos campi serão construídos nos municípios de Campos Sales, Cascavel, Lavras da Mangabeira, Mauriti e Fortaleza, nos bairros Messejana e São Gerardo. Quando estiverem em funcionamento, essas unidades oferecerão 8,4 mil novas vagas, majoritariamente em cursos técnicos integrados ao ensino médio.}
}


